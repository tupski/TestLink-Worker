# Wajib di produksi (Vercel/Cloudflare). Tanpa ini endpoint admin dinonaktifkan (503).
ADMIN_PASSWORD=ganti-dengan-sandi-kuat

# Opsional: origin tambahan untuk CORS, dipisah koma.
# Kosongkan bila aplikasi hanya diakses same-origin.
ALLOWED_ORIGINS=

# Database. DB_TYPE=sqlite (default) atau mysql/mariadb.
# Untuk MySQL: wajib `npm install mysql2` di server.
DB_TYPE=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=testlink_user
# DB_PASSWORD=
# DB_NAME=testlink_db
# DB_CONNECTION_LIMIT=10

# Opsional: port server lokal
PORT=3000
