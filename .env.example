# ============================================
# Application Configuration
# ============================================

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Port number for the application server
# For aaPanel Node Proxy deployment, this will be set by aaPanel
# Default: 3000
PORT=3000

# ============================================
# Database Configuration
# ============================================

# Database type: 'sqlite' or 'mysql'
# Use 'sqlite' for local development
# Use 'mysql' for aaPanel production deployment
# Requirement 3.1: Environment configuration for aaPanel
DB_TYPE=mysql

# ============================================
# MySQL Configuration
# ============================================
# Required when DB_TYPE=mysql
# These settings are used for aaPanel deployment with MySQL database
# Requirement 3.2: MySQL connection configuration

# MySQL server hostname or IP address
# For aaPanel: typically 'localhost' or '127.0.0.1'
DB_HOST=localhost

# MySQL server port
# Default MySQL port is 3306
DB_PORT=3306

# MySQL database username
# Create this user in aaPanel MySQL manager with appropriate permissions
DB_USER=testlink_user

# MySQL database password
# Set a strong password for security
# Requirement 3.2: Secure database authentication
DB_PASSWORD=your_secure_password

# MySQL database name
# Create this database in aaPanel MySQL manager before deployment
DB_NAME=testlink_db

# Maximum number of connections in the connection pool
# Recommended: 10 for optimal performance
# Requirement 1.3: Connection pooling for efficient MySQL connections
DB_CONNECTION_LIMIT=10

# ============================================
# SQLite Configuration
# ============================================
# Required when DB_TYPE=sqlite
# Used for local development and testing

# Path to SQLite database file
# The file will be created automatically if it doesn't exist
SQLITE_PATH=./data/database.sqlite

# ============================================
# Admin Configuration
# ============================================

# Password for accessing the admin panel
# Set a strong password to protect admin functionality
# Requirement 3.4: Admin authentication configuration
ADMIN_PASSWORD=your_admin_password

# ============================================
# Optional Features
# ============================================

# Google Safe Browsing API Key (optional)
# Used for link safety checking feature
# Get your API key from: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Maintenance Mode (true/false)
# When enabled, displays maintenance page to users
# Default: false
MAINTENANCE_MODE=false
