# ============================================
# Application Configuration
# ============================================

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Port number for the application server
# For aaPanel Node Proxy deployment, this will be set by aaPanel
# Default: 3000
PORT=3000

# Log level: debug, info, warn, error
# Default: debug (development), info (production)
# LOG_LEVEL=info

# ============================================
# Database Configuration
# ============================================

# Database type: 'sqlite' or 'mysql'
# Use 'sqlite' for local development
# Use 'mysql' for aaPanel production deployment
DB_TYPE=mysql

# ============================================
# MySQL Configuration
# ============================================
# Required when DB_TYPE=mysql

DB_HOST=localhost
DB_PORT=3306
DB_USER=testlink_user
DB_PASSWORD=your_secure_password
DB_NAME=testlink_db

# Maximum number of connections in the connection pool
# Recommended: 10 for optimal performance
DB_CONNECTION_LIMIT=10

# ============================================
# SQLite Configuration
# ============================================
# Required when DB_TYPE=sqlite
# Used for local development and testing

SQLITE_PATH=./data/database.sqlite

# ============================================
# Admin Configuration
# ============================================

# Password for accessing the admin panel.
# ⚠️  REQUIRED — the server will NOT start if this is missing or set to
#     a known default value in production mode.
ADMIN_PASSWORD=your_admin_password

# ============================================
# Security Configuration
# ============================================

# CORS allowed origins (comma-separated).
# If empty, only same-origin and localhost requests are allowed.
# Examples:
#   ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
ALLOW_ORIGINS=

# Rate limiting window in milliseconds (default: 60000 = 1 minute)
# RATE_LIMIT_WINDOW_MS=60000

# Max requests per window per IP for general API endpoints (default: 60)
# RATE_LIMIT_MAX=60

# Max requests per window per IP for admin endpoints (default: 20)
# RATE_LIMIT_ADMIN_MAX=20

# ============================================
# Optional Features
# ============================================

# Google Safe Browsing API Key (optional)
# Used for link safety checking feature
# Get your API key from: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Maintenance Mode (true/false)
# When enabled, displays maintenance page to users
# Default: false
MAINTENANCE_MODE=false
